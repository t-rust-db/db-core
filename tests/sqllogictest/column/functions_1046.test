# ---- refusals that stay refusals ----

statement error
SELECT date_part('fortnight', ts) FROM strtime

statement error
SELECT strftime(ts, '%s') FROM strtime

statement error
SELECT year(n) FROM typed_nulls

statement error
SELECT strftime('%Y', ts) FROM strtime

statement error
SELECT upper(n) FROM typed_nulls

# CAST of a non-TIMESTAMP to VARCHAR is answered since #948
# (blob_cast_948.test); of a DOUBLE it stays refused (errors_1014.test).
