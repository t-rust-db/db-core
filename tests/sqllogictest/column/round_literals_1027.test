# #1027: `round(x, n)` with `n < 0` rounds to tens, hundreds, ... half
# away from zero, in the argument's type (DuckDB; sqlite3's round takes a
# negative `n` as 0), and a decimal literal is typed from its text:
# `1.50` is DECIMAL(3,2), `2.0` DECIMAL(2,1), `.5` DECIMAL(1,1); one with
# an exponent (`1.5e2`) is a DOUBLE. `typed_nulls` has an INTEGER `n`, a
# DOUBLE `f` and a DECIMAL(9,2) `d`, with NULLs. Expectations written by
# `make refresh-column-sqllogictest` from DuckDB, never by hand.

# ---- round with negative digits ----

query IIIIII nosort
SELECT id, n, round(n, -1), round(n, -2), round(n * 1000, -3), round(n, -25) FROM typed_nulls WHERE id <= 20 ORDER BY id
