# #807: several count(DISTINCT ...) in one query. Tables events (six rows,
# NULLs, a list column) and production (5000 rows, five row groups).
# Expected results come from DuckDB (make refresh-column-sqllogictest).

# 1. Two and three distincts, with and without GROUP BY, beside other
# aggregates; the value of one does not depend on another's column.

query III nosort
SELECT count(DISTINCT source), count(DISTINCT severity), count(*) FROM events
----
3
2
6

query TIIIRI nosort
SELECT severity, count(DISTINCT source), sum(ts), count(DISTINCT event_id), avg(ts), count(DISTINCT ts) FROM events GROUP BY severity ORDER BY severity
----
high
3
120
4
30.0
4
low
2
90
2
45.0
2

query II nosort
SELECT count(DISTINCT source), count(DISTINCT event_id) FROM events WHERE ts > 1000
----
0
0

# 2. The query of #802: ranked labels, distinct events and sources.

query TII nosort
SELECT label, count(DISTINCT event_id) AS events, count(DISTINCT source) AS sources FROM events, UNNEST(labels) AS l(label) WHERE ts >= 10 AND severity = 'high' GROUP BY label ORDER BY events DESC, label LIMIT 25
----
x
2
1
y
2
2
NULL
1
1

query TIII nosort
SELECT label, count(DISTINCT event_id), count(DISTINCT source), count(*) FROM events, UNNEST(labels) AS l(label) GROUP BY label ORDER BY label
----
x
2
1
3
y
3
2
3
z
1
1
1
NULL
1
1
1

# 3. Over several row groups (segments), where a value repeats across them.

query TIII nosort
SELECT region, count(DISTINCT id), count(DISTINCT amount), count(*) FROM production GROUP BY region ORDER BY region
----
east
1250
1250
1250
north
1250
1250
1250
south
1250
1250
1250
west
1250
1250
1250

query IIII nosort
SELECT count(DISTINCT region), count(DISTINCT id), count(DISTINCT amount), count(*) FROM production
----
4
5000
5000
5000

query TII nosort
SELECT region, count(DISTINCT id), count(DISTINCT amount) FROM production WHERE id > 2500 GROUP BY region HAVING count(DISTINCT id) > 600 ORDER BY region
----
east
625
625
north
625
625
south
625
625
west
625
625

# 4. The same column twice, and a distinct beside a select-list order that
# is not the merge order.

query II nosort
SELECT count(DISTINCT region), count(DISTINCT region) FROM production
----
4
4

query IIT nosort
SELECT count(DISTINCT amount), count(DISTINCT id), region FROM production GROUP BY region ORDER BY region
----
1250
1250
east
1250
1250
north
1250
1250
south
1250
1250
west
