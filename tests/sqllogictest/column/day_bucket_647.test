# date_trunc(part, ts) over a TIMESTAMP column: the start of the calendar
# unit, UTC, in the column's units (rows here compare, count and group by
# it rather than print it: DuckDB prints a TIMESTAMP, db-core its integer).
# DuckDB's part names and aliases, any case; weeks start on Monday.

query II nosort
SELECT count(*), count(DISTINCT date_trunc('day', ts)) FROM typed_nulls
----
10000
674

query IIIII nosort
SELECT count(DISTINCT date_trunc('hour', ts)), count(DISTINCT date_trunc('week', ts)), count(DISTINCT date_trunc('month', ts)), count(DISTINCT date_trunc('quarter', ts)), count(DISTINCT date_trunc('year', ts)) FROM typed_nulls
----
9474
97
23
8
2

query IIIIII nosort
SELECT count(DISTINCT date_trunc('decade', ts)), count(DISTINCT date_trunc('century', ts)), count(DISTINCT date_trunc('millennium', ts)), count(DISTINCT date_trunc('isoyear', ts)), count(DISTINCT date_trunc('second', ts)), count(DISTINCT date_trunc('ms', ts)) FROM typed_nulls
----
1
1
1
2
9474
9474

