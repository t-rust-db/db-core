# #647: integer division `//` and remainder `%`, as DuckDB has them. Two
# integers give an integer: `//` truncated toward zero, `%` with the sign
# of the dividend, NULL for a zero divisor. A DOUBLE or DECIMAL operand
# makes `//` a float division; `%` stays exact over decimals and is fmod
# over floats. Neither is defined for a TIMESTAMP column (date_trunc is).

query III nosort
SELECT id, id // 1000, id % 1000 FROM typed_nulls ORDER BY id LIMIT 5
----
1
0
1
2
0
2
3
0
3
4
0
4
5
0
5

