west

query IT nosort
SELECT id * 2, region FROM production ORDER BY (id * 2) DESC LIMIT 3 OFFSET 1
----
9998
south
9996
north
9994
west

query TI nosort
SELECT region, count(*) * 2 FROM production GROUP BY region ORDER BY count(*) * 2 DESC, region
----
east
2500
north
2500
south
2500
west
2500

query I nosort
SELECT DISTINCT id - id + n FROM typed_nulls WHERE n BETWEEN 0 AND 3 ORDER BY 1 DESC
----
3
2
1
0

query II nosort
SELECT n * 2, count(*) FROM typed_nulls WHERE n IS NULL OR n BETWEEN 1 AND 2 GROUP BY 1 ORDER BY 1
