# Hex is an integer form only.
statement error
SELECT CAST(txt AS DOUBLE) FROM blob_text WHERE id = 6

query I nosort
SELECT sum(CAST(txt AS INTEGER)) FROM blob_text
----
1146

# The cast sees only the rows it is meant for: a conjunct beside it does
# not stop it from raising on another row here (DuckDB filters first).
query II nosort
SELECT id, CAST(txt AS BIGINT) + 1 FROM blob_text WHERE CAST(CASE WHEN id IN (1, 2, 7, 8) THEN txt END AS DOUBLE) > 15 ORDER BY id
----
2
21
7
1001
8
101

query I nosort
SELECT sum(CAST(CAST(raw AS VARCHAR) AS INTEGER)) FROM blob_text
----
1098

query I nosort
SELECT sum(raw::VARCHAR::INTEGER) FROM blob_text
----
1098

query II nosort
SELECT raw::VARCHAR::INT % 3 AS r, count(*) FROM blob_text GROUP BY r ORDER BY r
----
-1
1
0
1
1
3
2
2
NULL
1

statement error
SELECT CAST(bin AS VARCHAR)::INTEGER FROM blob_text WHERE id = 4

