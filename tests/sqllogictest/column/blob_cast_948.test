# #948: a BLOB used as a number is an error, as in DuckDB (it was a NULL
# or "no match", a silent wrong answer), and the casts DuckDB asks for are
# answered: CAST / `::` to VARCHAR, INTEGER, BIGINT and DOUBLE, and
# decode(blob). `blob_text` has a BLOB of numeric text (`raw`), BLOBs that
# are not all UTF-8 or printable (`bin`), VARCHAR numbers in the forms
# DuckDB's integer cast reads (`txt`), and NULLs on id 5. Expectations
# written by `make refresh-column-sqllogictest` from DuckDB, never by hand.
# A BLOB prints as `x'..'` hex here, so its text goes through hex().

# ---- a BLOB is no number ----

statement error
SELECT raw * 2 FROM blob_text

statement error
SELECT -raw FROM blob_text

statement error
SELECT raw + raw FROM blob_text

statement error
SELECT id FROM blob_text WHERE raw > 20

statement error
SELECT count(*) FROM blob_text WHERE raw * 2 > 0

statement error
SELECT CAST(raw AS INTEGER) FROM blob_text

# Two BLOBs compare bytewise, as before.
query I nosort
SELECT count(*) FROM blob_text WHERE raw = raw
----
7

# ---- BLOB to text ----

query ITT nosort
SELECT id, CAST(raw AS VARCHAR), raw::VARCHAR FROM blob_text ORDER BY id
----
1
10
10
2
20
20
3
30
30
4
40
40
5
NULL
NULL
6
-7
-7
7
1000
1000
8
5
5

query IT nosort
SELECT id, '[' || CAST(bin AS VARCHAR) || ']' FROM blob_text ORDER BY id
----
1
[\xFFA]
2
[\xC3\xA9]
3
[\x5C\x00]
4
[AB]
5
NULL
6
[]
7
[\x0A]
8
[Z]

query IT nosort
SELECT id, decode(raw) FROM blob_text ORDER BY id
----
1
10
2
20
3
30
4
40
5
NULL
6
-7
7
1000
8
5

query IT nosort
SELECT id, '[' || decode(bin) || ']' FROM blob_text WHERE id IN (2, 4, 6, 8) ORDER BY id
----
2
[é]
4
[AB]
6
[]
8
[Z]

# id 7 decodes to a newline, which a record cannot hold: its length.
query II nosort
SELECT id, length(decode(bin)) FROM blob_text WHERE id = 7
----
7
1

statement error
SELECT decode(bin) FROM blob_text WHERE id = 1

