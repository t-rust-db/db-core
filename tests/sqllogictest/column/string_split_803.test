# #803: string_split / str_split return a LIST<VARCHAR>, so a delimited string
# can be unnested. Table delimited: NULL, empty, one value, a separator at
# either end and doubled, a repeated value. A list is read through UNNEST,
# not printed: DuckDB prints a list differently from the column engine.
# Expected results come from DuckDB (make refresh-column-sqllogictest).

# 1. In FROM and in the SELECT list.

query IT nosort
SELECT id, label FROM delimited, UNNEST(string_split(csv, ',')) AS l(label) ORDER BY id, label
----
1
a
1
b
1
c
2
b
3
(empty)
5
(empty)
5
(empty)
5
a
6
(empty)
6
a
6
b
7
a
7
a

query IT nosort
SELECT id, UNNEST(string_split(csv, ',')) AS label FROM delimited ORDER BY id, label
----
1
a
1
b
1
c
2
b
3
(empty)
5
(empty)
5
(empty)
5
a
6
(empty)
6
a
6
b
7
a
7
a

query IT nosort
SELECT id, UNNEST(str_split(csv, ',')) AS label FROM delimited ORDER BY id, label
----
