# The same rows as production.parquet (Zstd), written with the other codecs
# storage/parquet/compression.rs decodes: Snappy and none.

query IIRR nosort
SELECT count(*), sum(id), min(amount), max(amount) FROM production_snappy
----
5000
12502500
2.5
12500.0

query TIRR nosort
SELECT region, count(*), sum(amount), avg(amount) FROM production_snappy GROUP BY region ORDER BY region
