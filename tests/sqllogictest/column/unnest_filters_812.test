query TIIII nosort
SELECT label, count(DISTINCT event_id), count(DISTINCT source), min(event_id), max(event_id) FROM ranked_events, UNNEST(string_split(labels, ',')) AS l(label) WHERE label = 'b' AND source <> 's3' GROUP BY label
