skipif db-core
query TIITT nosort
SELECT label, count(DISTINCT event_id), count(DISTINCT source), min(ts), max(ts) FROM ranked_events, UNNEST(string_split(labels, ',')) AS l(label) WHERE label = 'b' AND source <> 's3' GROUP BY label
----
