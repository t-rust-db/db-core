# typed_nulls: 10000 rows in five row groups, NULLs in every column but id
# (n INTEGER, f DOUBLE, s TEXT, b BOOLEAN, d DECIMAL(9,2), ts TIMESTAMP),
# and a skewed group key grp (big 8000, small 1000, tiny 900, NULL 100).

# Scans and NULL counts across row groups.

query IIIIIIII nosort
SELECT count(*), count(n), count(f), count(s), count(b), count(d), count(ts), count(grp) FROM typed_nulls
