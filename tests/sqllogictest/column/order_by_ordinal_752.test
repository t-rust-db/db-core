# #752: ORDER BY <ordinal> names a select item, 1-based: grouped with an
# aggregate, on a plain projection, mixed with names and aliases. Out of
# range, or naming `*` or an unaliased computed expression, is refused.

query TI nosort
SELECT region, count(*) FROM production GROUP BY region ORDER BY 2 DESC, 1 LIMIT 3
----
east
1250
north
1250
south
1250

query IT nosort
SELECT id, region FROM production WHERE id > 4990 ORDER BY 2, 1 DESC
