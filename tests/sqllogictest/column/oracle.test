# The cases of tools/check_column_oracle.sh not tied to one issue below:
# baseline aggregates, GROUP BY aliases and expressions (#623), exact
# integer arithmetic and DOUBLE `/` (#635). Table production: ids 1..5000,
# four regions, amounts; three row groups.

query I nosort
SELECT count(*) FROM production
----
