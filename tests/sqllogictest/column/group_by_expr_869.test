# #869: GROUP BY <expression> and GROUP BY <position>. A select item
# written the same way as an expression key is that key (spans and
# redundant parentheses aside); a position names the select item's
# expression, 1-based. NULL keys form their own group. Out of range, an
# aggregate (directly or by position) and a column read outside its key
# are refused.

query II rowsort
SELECT id > 2500, count(*) FROM production GROUP BY id > 2500
----
0
2500
1
2500

query II rowsort
SELECT (id > 2500), sum(amount) > 0 FROM production GROUP BY id > 2500
----
0
1
1
1

query TI rowsort
SELECT regexp_extract(region, '(n)', 1), count(*) FROM production GROUP BY regexp_extract(region, '(n)', 1)
----
(empty)
3750
n
1250

